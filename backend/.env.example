# ChibiFantasyMMO backend — example configuration.
#
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is not.
# Never put a real password, key or token in this file.
#
# Requirements: PHP 8.2+ with pdo_mysql, mbstring, openssl. MySQL 8.0+ or MariaDB 10.6+.

APP_ENV=development
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chibifantasy_dev
DB_USERNAME=change_me
DB_PASSWORD=

# Tests run against their own database and truncate it freely. Never point this
# at the development database, and never at anything resembling production.
DB_TEST_DATABASE=chibifantasy_test

# The live end-to-end run has its own database again, because PHPUnit truncates
# the one above and was silently destroying the account the Unity integration
# tests sign in as. Leave it unset and it falls back to DB_TEST_DATABASE, which
# works but reintroduces that ordering trap.
DB_INTEGRATION_DATABASE=chibifantasy_integration

# Bytes of entropy drawn from the CSPRNG for session identifiers and bearer
# tokens. 32 bytes is 256 bits. Do not lower these.
SESSION_ID_BYTES=32
SESSION_TOKEN_BYTES=32
SESSION_LIFETIME_SECONDS=86400
