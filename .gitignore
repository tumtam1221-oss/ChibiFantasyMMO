# ============================================================
# ChibiFantasyMMO — Unity .gitignore
# Phase 01 — Foundation
#
# Tracked on purpose (do NOT add ignore rules for these):
#   Assets/            — all project content + .meta files
#   Packages/          — manifest.json + packages-lock.json
#   ProjectSettings/   — all project configuration
# ============================================================

# ---------- Unity generated folders ----------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/
/[Mm]emoryCaptures/

# Recorder / asset store / addressables caches
/[Rr]ecordings/
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*
/[Ss]erverData/
.consulo/

# Nested occurrences (e.g. inside embedded packages)
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Ll]ogs/

# ---------- Generated IDE / solution files ----------
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.unityproj
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.tmp

# ---------- IDE / editor directories ----------
.vscode/
.idea/
.vs/
/[Ee]xportedObj/
*.sublime-project
*.sublime-workspace

# ---------- Unity3D generated meta files for ignored dirs ----------
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---------- Builds & packaged output ----------
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
crashlytics-build.properties

# ---------- Burst / IL2CPP ----------
/[Bb]urst[Cc]ache/
*.burst.debug
/[Ll]ibrary/Il2cppBuildCache/

# ---------- OS noise ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---------- Secrets / credentials ----------
# Never commit backend credentials, connection strings or keys.
*.env
.env.*
secrets.json
*.secret
*.pem
*.key
*.keystore
*.p12
!*.keystore.meta

# ---------- PHP backend (Phase 15) ----------
# Real credentials never enter the repository. The example file must, so it is
# re-included explicitly: the `.env.*` rule above would otherwise swallow it.
/backend/.env
/backend/.env.local
!/backend/.env.example
!*.env.example

# Composer dependencies are restored by `composer install`, never committed.
/backend/vendor/
/backend/.phpunit.result.cache
/backend/.phpunit.cache/

# Local database runtime data must never be committed.
/backend/storage/
/backend/logs/
